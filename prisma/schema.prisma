// OlliePod schema
// Section 4a: category-bucket inventory model + intake logging (Section 2/3)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// The "standing" Whatnot/eBay show tiers that double as the bucket's brand/
// channel dimension. Deals & Steals only ever receives transfers from
// Torrid/LB buckets (Section 3 "Resolved" note + owner clarification).
// Themed Raid Trains are intentionally NOT part of this enum -- they are a
// separate campaign-style entity layered on top of these standing buckets
// (soft-reserve pulls, own COGS/revenue/profit totals), not a bucket key.
enum BucketShow {
  TORRID_LB
  RANDOM_3
  RANDOM_5_8
  EBAY
  DEALS_STEALS
}

// Bra/Lingerie buckets omit the show dimension entirely (brand/channel
// doesn't affect their price per Section 3's category-override table), so
// itemType is what drives whether `show` is required on a CategoryBucket.
enum ItemType {
  TOP
  BOTTOM
  DRESS
  JEANS_SHORTS
  BRA
  LINGERIE
  OTHER
}

enum TagStatus {
  PREOWNED
  NWT
}

enum HaulChannel {
  GOODWILL_BINS
  THRIFT
  VINTED
  WHATNOT_SOURCE
}

// The bulk post-haul sorting piles (Section 2) for Goodwill Bins / Thrift
// hauls only. Vinted and Whatnot-as-source hauls are itemized per order
// instead (see OrderLine) and never go through this pile workflow.
// SHOP_ITEM is the shared Bra/Lingerie/Jeans-Shorts/Other pile -- it's its
// own top-level destination, not a show, so it never appears in
// SHOW_FOR_DESTINATION (src/lib/hauls.ts).
enum SortDestination {
  EBAY
  TORRID_LB
  RANDOM_3
  RANDOM_5_8
  SHOP_ITEM
  PERSONAL
  NEEDS_WASH
  TRASH
}

enum TransferReason {
  DEALS_STEALS_MARKDOWN
}

// AUCTION/BUY_NOW rows are real inventory sales; GIVEAWAY rows are
// promotional deductions with no linked bucket and are auto-skipped.
enum SaleKind {
  ITEM_SALE
  GIVEAWAY
}

enum SaleStatus {
  PENDING
  RECONCILED
  SKIPPED
}

// EARMARKED: pulled into a raid train, still fully counted in its home
// bucket. SOLD: reconciled against a real sale -- only then does the home
// bucket actually decrement. RELEASED: un-earmarked without selling: a
// no-op on the bucket, since EARMARKED never touched it.
enum RaidTrainPullStatus {
  EARMARKED
  SOLD
  RELEASED
}

// ADDED increases the death pile's remaining count (the initial count, or a
// later top-up if more unlisted items turn up). LISTED decreases it when
// items get listed on eBay.
enum DeathPileEntryKind {
  ADDED
  LISTED
}

// Which marketplace-import pipeline a Sale came from. NIFTY_EBAY covers
// eBay, Poshmark, and Depop -- these are the same crosslisted inventory
// against the same EBAY-show bucket in this app, not separate businesses,
// so they share one channel rather than three.
enum SaleChannel {
  WHATNOT
  NIFTY_EBAY
}

// ---------------------------------------------------------------------------
// Category buckets (Section 4a)
// ---------------------------------------------------------------------------

model CategoryBucket {
  id String @id @default(cuid())
  // Null for the Shop Item item types (Bra/Lingerie/Jeans-Shorts/Other),
  // which skip the show dimension entirely and crosslist from one pool.
  show BucketShow?
  // Null for the flat shows (eBay/$3 Pull/$5-8 Pull) -- Section 4a owner
  // correction: those never split by type/tag, just one count+COGS bucket
  // per show. Non-null (Top/Bottom/Dress) for Torrid/LB and Deals & Steals,
  // and non-null (Bra/Lingerie/Jeans-Shorts/Other) for the Shop Item pool.
  itemType  ItemType?
  tagStatus TagStatus?

  countOnHand Int     @default(0)
  totalCogs   Decimal @default(0) @db.Decimal(10, 2)
  // avgCogs is intentionally NOT stored -- it's always totalCogs/countOnHand,
  // computed at read time to avoid drift between the two source-of-truth
  // fields. See src/lib/buckets.ts.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  haulSortEntries        HaulSortEntry[]
  resolvedNeedsWashUnits ResolvedNeedsWashUnit[]
  orderLines             OrderLine[]
  startingCounts         StartingCountEntry[]
  transfersOut           BucketTransferLog[]     @relation("TransferFrom")
  transfersIn            BucketTransferLog[]     @relation("TransferTo")
  sales                  Sale[]
  raidTrainPulls         RaidTrainPull[]
  saleBundleComponents   SaleBundleComponent[]

  @@unique([show, itemType, tagStatus])
  @@index([itemType, tagStatus])
}

// One-time starting-inventory reconciliation (Section 4a "Build requirement").
// Kept as its own append-only log (rather than just mutating the bucket)
// so there's an audit trail of when/why a starting count was entered.
model StartingCountEntry {
  id       String         @id @default(cuid())
  bucket   CategoryBucket @relation(fields: [bucketId], references: [id])
  bucketId String

  count     Int
  totalCogs Decimal @db.Decimal(10, 2)
  note      String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Intake: Hauls (Goodwill Bins / Thrift / Vinted / Whatnot-as-source)
// ---------------------------------------------------------------------------

model Haul {
  id       String      @id @default(cuid())
  channel  HaulChannel
  haulDate DateTime

  // Bins/Thrift only: one total price for the whole haul, split evenly
  // across sellable items once sorting is finalized (Section 2).
  totalCost Decimal? @db.Decimal(10, 2)

  notes String?

  // Locked true once bin/thrift sort entries have been used to compute
  // per-item COGS and apply bucket increments. Prevents double-application.
  finalized   Boolean   @default(false)
  finalizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sortEntries    HaulSortEntry[]
  needsWashItems NeedsWashQueueItem[]
  orderLines     OrderLine[]
  receipts       Receipt[]

  @@index([channel, haulDate])
}

// Bins/Thrift: one row per (destination pile, itemType, tagStatus)
// combination counted during sorting. quantity is the count of physical
// items sorted into that combination.
model HaulSortEntry {
  id     String @id @default(cuid())
  haul   Haul   @relation(fields: [haulId], references: [id], onDelete: Cascade)
  haulId String

  destination SortDestination
  // Required for EBAY / TORRID_LB / RANDOM_3 / RANDOM_5_8 / SHOP_ITEM /
  // NEEDS_WASH (anything that is or will become sellable). Left null for
  // PERSONAL / TRASH, which never resolve into a bucket.
  itemType    ItemType?
  tagStatus   TagStatus?
  // Brand, e.g. "Torrid" / "Lane Bryant" -- only meaningful for a
  // SHOP_ITEM/JEANS_SHORTS line, since brand affects resale price for
  // jeans/shorts. Purely descriptive; not part of the bucket key.
  brand       String?

  quantity Int

  // Set once the haul is finalized: totalCost / total-sellable-items for
  // this haul (sellable = EBAY + TORRID_LB + RANDOM_3 + RANDOM_5_8 +
  // NEEDS_WASH counts; PERSONAL and TRASH are excluded from the divisor
  // per Section 2).
  cogsPerItem Decimal? @db.Decimal(10, 2)

  // Which bucket this entry's units were credited to once finalized
  // (null for PERSONAL/TRASH/NEEDS_WASH, which don't hit a bucket directly).
  bucket   CategoryBucket? @relation(fields: [bucketId], references: [id])
  bucketId String?

  createdAt DateTime @default(now())

  @@index([haulId])
}

// Bins/Thrift: pending items sorted into "Needs wash/stain treatment"
// (Section 2, pile 5). Holds the per-item COGS locked in at haul-finalize
// time. Owner correction: nothing about the item gets categorized here --
// that's not knowable until it's actually been washed/treated -- this is
// purely a count + locked-in COGS to carry forward until resolve time.
model NeedsWashQueueItem {
  id     String @id @default(cuid())
  haul   Haul   @relation(fields: [haulId], references: [id], onDelete: Cascade)
  haulId String

  quantityRemaining Int
  cogsPerItem       Decimal @db.Decimal(10, 2)

  resolvedInto ResolvedNeedsWashUnit[]

  createdAt DateTime @default(now())

  @@index([haulId])
}

// Whether a treated unit came out sellable (SAVED -- goes into a real
// bucket, same dropdown as log intake) or the stain/damage didn't come out
// (DISCARDED -- written off, no bucket, its locked-in COGS is a sunk loss).
enum NeedsWashResolution {
  SAVED
  DISCARDED
}

// One resolve action can dispose of a partial quantity from a queue item
// (e.g. resolve 2 of 5 pending units into Torrid/LB Top - Preowned).
model ResolvedNeedsWashUnit {
  id          String             @id @default(cuid())
  queueItem   NeedsWashQueueItem @relation(fields: [queueItemId], references: [id])
  queueItemId String

  quantity   Int
  resolution NeedsWashResolution @default(SAVED)
  // Null when resolution is DISCARDED -- nothing to credit a bucket with.
  bucket     CategoryBucket?     @relation(fields: [bucketId], references: [id])
  bucketId   String?

  resolvedAt DateTime @default(now())

  @@index([queueItemId])
}

// Vinted / Whatnot-as-source: itemized per order. One row per destination/
// type/tag line the order was sorted into; cogsPerItem is the order-level
// flat rate (order total / total item count, Section 2/4) -- same value
// across every line in one order, same shape as HaulSortEntry.
model OrderLine {
  id     String @id @default(cuid())
  haul   Haul   @relation(fields: [haulId], references: [id], onDelete: Cascade)
  haulId String

  // Null for a Shop Item line (Bra/Lingerie/Jeans-Shorts/Other) -- those
  // have no show, same as a CategoryBucket with show=null.
  show      BucketShow?
  itemType  ItemType?
  tagStatus TagStatus?

  quantity    Int     @default(1)
  cogsPerItem Decimal @db.Decimal(10, 2)

  description String?
  // Brand, e.g. "Torrid" / "Lane Bryant" -- only meaningful for a
  // JEANS_SHORTS line, since brand affects resale price for jeans/shorts.
  // Purely descriptive; not part of the bucket key.
  brand       String?

  bucket   CategoryBucket @relation(fields: [bucketId], references: [id])
  bucketId String

  createdAt DateTime @default(now())

  @@index([haulId])
}

// Photo/screenshot receipts. A haul can carry more than one (e.g. a bins
// haul receipt, or several Vinted itemized-order-detail screenshots).
model Receipt {
  id     String @id @default(cuid())
  haul   Haul   @relation(fields: [haulId], references: [id], onDelete: Cascade)
  haulId String

  objectKey String // R2 object key
  fileName  String?

  createdAt DateTime @default(now())

  @@index([haulId])
}

// ---------------------------------------------------------------------------
// Bucket-to-bucket transfers (currently: Deals & Steals markdowns)
// ---------------------------------------------------------------------------

model BucketTransferLog {
  id     String         @id @default(cuid())
  reason TransferReason

  fromBucket   CategoryBucket @relation("TransferFrom", fields: [fromBucketId], references: [id])
  fromBucketId String
  toBucket     CategoryBucket @relation("TransferTo", fields: [toBucketId], references: [id])
  toBucketId   String

  quantity   Int
  cogsAmount Decimal @db.Decimal(10, 2) // cogsPerItem (at time of transfer) * quantity

  note String?

  createdAt DateTime @default(now())

  @@index([fromBucketId])
  @@index([toBucketId])
}

// ---------------------------------------------------------------------------
// Marketplace sale imports + reconciliation (Section 4a / Section 7)
// ---------------------------------------------------------------------------

// One row per imported CSV -- a Whatnot "Weekly Earnings Report" or a Nifty
// "Orders" export. reportStartDate/weekNumber are Whatnot-only bookkeeping
// and are left null for a Nifty import.
model SaleImport {
  id              String    @id @default(cuid())
  reportStartDate DateTime?
  weekNumber      Int?
  fileName        String?
  importedAt      DateTime  @default(now())

  sales Sale[]
}

// One row per CSV line, from either import pipeline (see SaleChannel).
// GIVEAWAY rows (Whatnot only) are stored for the record but marked SKIPPED
// immediately -- they're promotional deductions, not inventory sales, and
// never get a bucket. Real sale rows start PENDING with a best-effort
// auto-matched itemType/tagStatus guess (parsed from the listing title)
// that the reconciliation tab lets you confirm or correct before it touches
// a bucket -- same "confirm before it touches inventory" shape as the Needs
// Wash queue. For a Whatnot sale, show is also guessed (only the standing
// Torrid/LB show has a reliable signal; Raid Trains and other shows come
// through unguessed). For a Nifty sale, show is always EBAY -- eBay,
// Poshmark, and Depop are crosslisted against the same bucket, not separate
// shows, so there's nothing to guess there.
model Sale {
  id           String     @id @default(cuid())
  saleImport   SaleImport @relation(fields: [saleImportId], references: [id], onDelete: Cascade)
  saleImportId String

  channel SaleChannel

  // Unique per payout line, used to skip rows already imported by a prior
  // (possibly overlapping) CSV. Whatnot supplies a real LEDGER_TRANSACTION_ID;
  // Nifty's export has no ID column, so its rows use a synthesized key
  // (hash of marketplace + item + sold-at + price).
  externalKey String @unique

  // Nifty's export has no order-ID column, so this is Whatnot-only.
  orderId String?

  listingTitle           String
  // The Whatnot livestream title, or the specific Nifty marketplace
  // (eBay/Poshmark/Depop) a sale actually happened on -- shown for
  // traceability even though Nifty sales all reconcile against the same
  // eBay-show bucket regardless of which of the three it was.
  channelDetail          String?
  quantitySold           Int      @default(1)
  transactionCompletedAt DateTime

  // Whatnot-specific fee breakdown; null for a Nifty sale, whose different
  // fee categories don't map cleanly onto these two and are already netted
  // into transactionAmount instead.
  originalItemPrice    Decimal? @db.Decimal(10, 2)
  commissionFee        Decimal? @db.Decimal(10, 2)
  paymentProcessingFee Decimal? @db.Decimal(10, 2)
  // Net revenue for this line (gross price minus marketplace fees, and for
  // Nifty minus its own listed Cost of Goods backed back out) -- this is
  // what reconciliation profit is computed against, not the gross price.
  transactionAmount    Decimal  @db.Decimal(10, 2)

  buyerName  String?
  buyerState String?

  kind   SaleKind
  status SaleStatus @default(PENDING)

  // Auto-matched guess (kind=ITEM_SALE only), editable up until reconciled.
  show      BucketShow?
  itemType  ItemType?
  tagStatus TagStatus?

  bucket   CategoryBucket? @relation(fields: [bucketId], references: [id])
  bucketId String?

  // Set instead of show/itemType/tagStatus when this sale reconciles
  // against a Raid Train pull rather than a standing show -- see
  // RaidTrainPull. The pull already carries its bucket/type/tag, so those
  // fields are left null for a raid-train reconciliation. Whatnot-only in
  // practice; Nifty sales always reconcile in plain bucket mode.
  raidTrainPull   RaidTrainPull? @relation(fields: [raidTrainPullId], references: [id])
  raidTrainPullId String?        @unique

  // Also left null (along with bucketId) when this sale reconciles as a
  // bundle of several different categories sold together -- see
  // SaleBundleComponent for the per-category breakdown. Only known to be a
  // bundle after the sale happens, so this can't be set up at intake.
  bundleComponents SaleBundleComponent[]

  // Snapshot of the cogs charged against this sale at reconcile time (the
  // bucket's live avg COGS for a standing-show sale, the pull's carried
  // COGS for a raid-train sale, or the sum of each component's own live
  // avg COGS for a bundle sale) * quantitySold, and the resulting profit
  // (transactionAmount - cogsAmount).
  cogsAmount   Decimal?  @db.Decimal(10, 2)
  profitAmount Decimal?  @db.Decimal(10, 2)
  reconciledAt DateTime?

  createdAt DateTime @default(now())

  @@index([saleImportId])
  @@index([status])
  @@index([channel])
}

// One row per category/quantity grouped into a bundle sale -- only created
// when a sale is reconciled as a bundle (there's no way to know in advance
// what will end up sold together, so this is never set up at intake).
// Each component is decremented from its own bucket at that bucket's live
// avg COGS, same as a normal single-bucket reconciliation. The sale's
// total revenue is then split across components proportional to each
// one's own COGS share (equal split if every component's COGS happens to
// be zero), so each component gets a real profit figure instead of one
// blended number smeared across a heterogeneous mix.
model SaleBundleComponent {
  id     String @id @default(cuid())
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId String

  bucket   CategoryBucket @relation(fields: [bucketId], references: [id])
  bucketId String

  show      BucketShow?
  itemType  ItemType?
  tagStatus TagStatus?

  quantity      Int
  cogsAmount    Decimal @db.Decimal(10, 2)
  revenueAmount Decimal @db.Decimal(10, 2)
  profitAmount  Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([bucketId])
}

// ---------------------------------------------------------------------------
// Themed Raid Trains: a campaign entity layered on top of the standing
// buckets. Pulling an item into a raid train is an earmark, not a transfer
// -- it stays fully counted in its home bucket (countOnHand/totalCogs
// untouched) until a real sale reconciles against the pull. Custom raid
// pricing is tracked per pull and is independent of the bucket's own price.
// ---------------------------------------------------------------------------

model RaidTrain {
  id       String   @id @default(cuid())
  name     String
  raidDate DateTime
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pulls RaidTrainPull[]

  @@index([raidDate])
}

// One row per item (or bundle) earmarked into a raid train from its home
// bucket. bundleQuantity/bundlePrice is a real bundle -- a custom price set
// for several items pulled and sold together (e.g. a "$1 bundle" of 2
// items) -- distinct from intake's flat per-item cost-splitting, which
// isn't a bundle at all.
model RaidTrainPull {
  id          String    @id @default(cuid())
  raidTrain   RaidTrain @relation(fields: [raidTrainId], references: [id], onDelete: Cascade)
  raidTrainId String

  // Home bucket this was earmarked from -- itemType/tagStatus/show for the
  // pull are implied by this bucket, not stored redundantly.
  bucket   CategoryBucket @relation(fields: [bucketId], references: [id])
  bucketId String

  bundleQuantity Int     @default(1)
  bundlePrice    Decimal @db.Decimal(10, 2)
  description    String?

  // The bucket's avg COGS per item at the moment of pull, locked in so the
  // raid train's own COGS/profit roll-up doesn't drift if the bucket's
  // average moves afterward (same locked-in-at-intake pattern as
  // NeedsWashQueueItem.cogsPerItem).
  carriedCogsPerItem Decimal @db.Decimal(10, 2)

  status   RaidTrainPullStatus @default(EARMARKED)
  pulledAt DateTime            @default(now())

  sale Sale?

  @@index([raidTrainId])
  @@index([bucketId])
}

// ---------------------------------------------------------------------------
// eBay Death Pile (Section 8): a standalone running count of unlisted eBay
// backlog items, unconnected to the CategoryBucket/COGS system -- these are
// items with no known per-item cost or history, just a count to work down.
// No dates, no aging, no threshold: countRemaining is a plain running total
// that goes up when more items are added and down as they get listed.
// ---------------------------------------------------------------------------

model DeathPile {
  id             String   @id @default(cuid())
  countRemaining Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entries DeathPileEntry[]
}

model DeathPileEntry {
  id          String    @id @default(cuid())
  deathPile   DeathPile @relation(fields: [deathPileId], references: [id], onDelete: Cascade)
  deathPileId String

  kind     DeathPileEntryKind
  quantity Int
  note     String?

  createdAt DateTime @default(now())

  @@index([deathPileId])
}
