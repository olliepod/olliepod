// OlliePod schema
// Section 4a: category-bucket inventory model + intake logging (Section 2/3)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// The "standing" Whatnot/eBay show tiers that double as the bucket's brand/
// channel dimension. Deals & Steals only ever receives transfers from
// Torrid/LB buckets (Section 3 "Resolved" note + owner clarification).
// Themed Raid Trains are intentionally NOT part of this enum -- they are a
// separate campaign-style entity layered on top of these standing buckets
// (soft-reserve pulls, own COGS/revenue/profit totals), not a bucket key.
enum BucketShow {
  TORRID_LB
  RANDOM_3
  RANDOM_5_8
  EBAY
  DEALS_STEALS
}

// Bra/Lingerie buckets omit the show dimension entirely (brand/channel
// doesn't affect their price per Section 3's category-override table), so
// itemType is what drives whether `show` is required on a CategoryBucket.
enum ItemType {
  TOP
  BOTTOM
  DRESS
  JEANS_SHORTS
  BRA
  LINGERIE
  OTHER
}

enum TagStatus {
  PREOWNED
  NWT
}

enum HaulChannel {
  GOODWILL_BINS
  THRIFT
  VINTED
  WHATNOT_SOURCE
}

// The bulk post-haul sorting piles (Section 2) for Goodwill Bins / Thrift
// hauls only. Vinted and Whatnot-as-source hauls are itemized per order
// instead (see OrderLine) and never go through this pile workflow.
enum SortDestination {
  EBAY
  TORRID_LB
  RANDOM_3
  PERSONAL
  NEEDS_WASH
  TRASH
}

enum TransferReason {
  DEALS_STEALS_MARKDOWN
}

// AUCTION/BUY_NOW rows are real inventory sales; GIVEAWAY rows are
// promotional deductions with no linked bucket and are auto-skipped.
enum SaleKind {
  ITEM_SALE
  GIVEAWAY
}

enum SaleStatus {
  PENDING
  RECONCILED
  SKIPPED
}

// EARMARKED: pulled into a raid train, still fully counted in its home
// bucket. SOLD: reconciled against a real sale -- only then does the home
// bucket actually decrement. RELEASED: un-earmarked without selling: a
// no-op on the bucket, since EARMARKED never touched it.
enum RaidTrainPullStatus {
  EARMARKED
  SOLD
  RELEASED
}

// ---------------------------------------------------------------------------
// Category buckets (Section 4a)
// ---------------------------------------------------------------------------

model CategoryBucket {
  id        String      @id @default(cuid())
  // Null only for BRA / LINGERINE item types, which skip the show dimension.
  show      BucketShow?
  itemType  ItemType
  tagStatus TagStatus

  countOnHand Int     @default(0)
  totalCogs   Decimal @default(0) @db.Decimal(10, 2)
  // avgCogs is intentionally NOT stored -- it's always totalCogs/countOnHand,
  // computed at read time to avoid drift between the two source-of-truth
  // fields. See src/lib/buckets.ts.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  haulSortEntries        HaulSortEntry[]
  resolvedNeedsWashUnits ResolvedNeedsWashUnit[]
  orderLines             OrderLine[]
  startingCounts         StartingCountEntry[]
  transfersOut           BucketTransferLog[]     @relation("TransferFrom")
  transfersIn            BucketTransferLog[]     @relation("TransferTo")
  sales                  Sale[]
  raidTrainPulls         RaidTrainPull[]

  @@unique([show, itemType, tagStatus])
  @@index([itemType, tagStatus])
}

// One-time starting-inventory reconciliation (Section 4a "Build requirement").
// Kept as its own append-only log (rather than just mutating the bucket)
// so there's an audit trail of when/why a starting count was entered.
model StartingCountEntry {
  id       String         @id @default(cuid())
  bucket   CategoryBucket @relation(fields: [bucketId], references: [id])
  bucketId String

  count     Int
  totalCogs Decimal @db.Decimal(10, 2)
  note      String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Intake: Hauls (Goodwill Bins / Thrift / Vinted / Whatnot-as-source)
// ---------------------------------------------------------------------------

model Haul {
  id       String      @id @default(cuid())
  channel  HaulChannel
  haulDate DateTime

  // Bins/Thrift only: one total price for the whole haul, split evenly
  // across sellable items once sorting is finalized (Section 2).
  totalCost Decimal? @db.Decimal(10, 2)

  notes String?

  // Locked true once bin/thrift sort entries have been used to compute
  // per-item COGS and apply bucket increments. Prevents double-application.
  finalized   Boolean   @default(false)
  finalizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sortEntries    HaulSortEntry[]
  needsWashItems NeedsWashQueueItem[]
  orderLines     OrderLine[]
  receipts       Receipt[]

  @@index([channel, haulDate])
}

// Bins/Thrift: one row per (destination pile, itemType, tagStatus)
// combination counted during sorting. quantity is the count of physical
// items sorted into that combination.
model HaulSortEntry {
  id     String @id @default(cuid())
  haul   Haul   @relation(fields: [haulId], references: [id], onDelete: Cascade)
  haulId String

  destination SortDestination
  // Required for EBAY / TORRID_LB / RANDOM_3 / NEEDS_WASH (anything that is
  // or will become sellable). Left null for PERSONAL / TRASH, which never
  // resolve into a bucket.
  itemType    ItemType?
  tagStatus   TagStatus?

  quantity Int

  // Set once the haul is finalized: totalCost / total-sellable-items for
  // this haul (sellable = EBAY + TORRID_LB + RANDOM_3 + NEEDS_WASH counts;
  // PERSONAL and TRASH are excluded from the divisor per Section 2).
  cogsPerItem Decimal? @db.Decimal(10, 2)

  // Which bucket this entry's units were credited to once finalized
  // (null for PERSONAL/TRASH/NEEDS_WASH, which don't hit a bucket directly).
  bucket   CategoryBucket? @relation(fields: [bucketId], references: [id])
  bucketId String?

  createdAt DateTime @default(now())

  @@index([haulId])
}

// Bins/Thrift: pending items sorted into "Needs wash/stain treatment"
// (Section 2, pile 5). Holds the per-item COGS locked in at haul-finalize
// time; resolved individually later into a real bucket once treated.
model NeedsWashQueueItem {
  id     String @id @default(cuid())
  haul   Haul   @relation(fields: [haulId], references: [id], onDelete: Cascade)
  haulId String

  // Best-guess type at sort time, if known (e.g. "this is a top, just
  // stained"). Not required, since wash/treatment may reveal it belongs
  // elsewhere -- the actual bucket is chosen at resolve time.
  itemTypeGuess ItemType?

  quantityRemaining Int
  cogsPerItem       Decimal @db.Decimal(10, 2)

  resolvedInto ResolvedNeedsWashUnit[]

  createdAt DateTime @default(now())

  @@index([haulId])
}

// One resolve action can dispose of a partial quantity from a queue item
// (e.g. resolve 2 of 5 pending units into Torrid/LB Top - Preowned).
model ResolvedNeedsWashUnit {
  id          String             @id @default(cuid())
  queueItem   NeedsWashQueueItem @relation(fields: [queueItemId], references: [id])
  queueItemId String

  quantity Int
  bucket   CategoryBucket @relation(fields: [bucketId], references: [id])
  bucketId String

  resolvedAt DateTime @default(now())

  @@index([queueItemId])
}

// Vinted / Whatnot-as-source: itemized per order. One row per line; a
// bundle is represented by bundleQuantity > 1 with bundlePrice covering
// all of them (split evenly per Section 2/4).
model OrderLine {
  id     String @id @default(cuid())
  haul   Haul   @relation(fields: [haulId], references: [id], onDelete: Cascade)
  haulId String

  show      BucketShow
  itemType  ItemType
  tagStatus TagStatus

  bundleQuantity Int     @default(1)
  bundlePrice    Decimal @db.Decimal(10, 2)

  description String?

  bucket   CategoryBucket @relation(fields: [bucketId], references: [id])
  bucketId String

  createdAt DateTime @default(now())

  @@index([haulId])
}

// Photo/screenshot receipts. A haul can carry more than one (e.g. a bins
// haul receipt, or several Vinted itemized-order-detail screenshots).
model Receipt {
  id     String @id @default(cuid())
  haul   Haul   @relation(fields: [haulId], references: [id], onDelete: Cascade)
  haulId String

  objectKey String // R2 object key
  fileName  String?

  createdAt DateTime @default(now())

  @@index([haulId])
}

// ---------------------------------------------------------------------------
// Bucket-to-bucket transfers (currently: Deals & Steals markdowns)
// ---------------------------------------------------------------------------

model BucketTransferLog {
  id     String         @id @default(cuid())
  reason TransferReason

  fromBucket   CategoryBucket @relation("TransferFrom", fields: [fromBucketId], references: [id])
  fromBucketId String
  toBucket     CategoryBucket @relation("TransferTo", fields: [toBucketId], references: [id])
  toBucketId   String

  quantity   Int
  cogsAmount Decimal @db.Decimal(10, 2) // cogsPerItem (at time of transfer) * quantity

  note String?

  createdAt DateTime @default(now())

  @@index([fromBucketId])
  @@index([toBucketId])
}

// ---------------------------------------------------------------------------
// Weekly Earnings Report import + sale reconciliation (Section 4a)
// ---------------------------------------------------------------------------

// One row per imported Whatnot "Weekly Earnings Report" CSV.
model SaleImport {
  id              String   @id @default(cuid())
  reportStartDate DateTime
  weekNumber      Int
  fileName        String?
  importedAt      DateTime @default(now())

  sales Sale[]
}

// One row per CSV line. GIVEAWAY rows are stored for the record but marked
// SKIPPED immediately -- they're promotional deductions, not inventory
// sales, and never get a bucket. AUCTION/item-sale rows start PENDING with
// a best-effort auto-matched show/itemType/tagStatus guess (parsed from
// LISTING_TITLE / LIVESTREAM_TITLE) that the reconciliation tab lets you
// confirm or correct before it touches a bucket -- same "confirm before it
// touches inventory" shape as the Needs Wash queue. Livestream titles that
// aren't the standing Torrid/LB show (e.g. themed Raid Trains, which aren't
// modeled as their own entity yet) come through with no show guess and need
// a manual pick.
model Sale {
  id           String     @id @default(cuid())
  saleImport   SaleImport @relation(fields: [saleImportId], references: [id], onDelete: Cascade)
  saleImportId String

  // Whatnot's LEDGER_TRANSACTION_ID -- unique per payout line, used to skip
  // rows already imported by a prior (possibly overlapping) CSV.
  ledgerTransactionId String @unique

  orderId                String
  listingTitle           String
  livestreamTitle        String?
  quantitySold           Int      @default(1)
  transactionCompletedAt DateTime

  originalItemPrice    Decimal @db.Decimal(10, 2)
  commissionFee        Decimal @db.Decimal(10, 2)
  paymentProcessingFee Decimal @db.Decimal(10, 2)
  // Net earnings for this line (item price minus commission/processing
  // fees) -- this is the revenue figure reconciliation profit is computed
  // against, not the gross item price.
  transactionAmount    Decimal @db.Decimal(10, 2)

  buyerName  String?
  buyerState String?

  kind   SaleKind
  status SaleStatus @default(PENDING)

  // Auto-matched guess (kind=ITEM_SALE only), editable up until reconciled.
  show      BucketShow?
  itemType  ItemType?
  tagStatus TagStatus?

  bucket   CategoryBucket? @relation(fields: [bucketId], references: [id])
  bucketId String?

  // Set instead of show/itemType/tagStatus when this sale reconciles
  // against a Raid Train pull rather than a standing show -- see
  // RaidTrainPull. The pull already carries its bucket/type/tag, so those
  // fields are left null for a raid-train reconciliation.
  raidTrainPull   RaidTrainPull? @relation(fields: [raidTrainPullId], references: [id])
  raidTrainPullId String?        @unique

  // Snapshot of the cogs charged against this sale at reconcile time (the
  // bucket's live avg COGS for a standing-show sale, or the pull's carried
  // COGS for a raid-train sale) * quantitySold, and the resulting profit
  // (transactionAmount - cogsAmount).
  cogsAmount   Decimal?  @db.Decimal(10, 2)
  profitAmount Decimal?  @db.Decimal(10, 2)
  reconciledAt DateTime?

  createdAt DateTime @default(now())

  @@index([saleImportId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Themed Raid Trains: a campaign entity layered on top of the standing
// buckets. Pulling an item into a raid train is an earmark, not a transfer
// -- it stays fully counted in its home bucket (countOnHand/totalCogs
// untouched) until a real sale reconciles against the pull. Custom raid
// pricing is tracked per pull and is independent of the bucket's own price.
// ---------------------------------------------------------------------------

model RaidTrain {
  id       String   @id @default(cuid())
  name     String
  raidDate DateTime
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pulls RaidTrainPull[]

  @@index([raidDate])
}

// One row per item (or bundle) earmarked into a raid train from its home
// bucket. bundleQuantity/bundlePrice mirror OrderLine's bundle pattern
// (e.g. a "$1 bundle" of 2 items pulled and priced together).
model RaidTrainPull {
  id          String    @id @default(cuid())
  raidTrain   RaidTrain @relation(fields: [raidTrainId], references: [id], onDelete: Cascade)
  raidTrainId String

  // Home bucket this was earmarked from -- itemType/tagStatus/show for the
  // pull are implied by this bucket, not stored redundantly.
  bucket   CategoryBucket @relation(fields: [bucketId], references: [id])
  bucketId String

  bundleQuantity Int     @default(1)
  bundlePrice    Decimal @db.Decimal(10, 2)
  description    String?

  // The bucket's avg COGS per item at the moment of pull, locked in so the
  // raid train's own COGS/profit roll-up doesn't drift if the bucket's
  // average moves afterward (same locked-in-at-intake pattern as
  // NeedsWashQueueItem.cogsPerItem).
  carriedCogsPerItem Decimal @db.Decimal(10, 2)

  status   RaidTrainPullStatus @default(EARMARKED)
  pulledAt DateTime            @default(now())

  sale Sale?

  @@index([raidTrainId])
  @@index([bucketId])
}
